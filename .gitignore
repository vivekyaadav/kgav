data/raw/*
data/interim/*
# ONE LEVEL DEEPER, SO THE NEGATION BELOW CAN APPLY (fix-list P12).
# This was `data/releases/*`, which ignores the release DIRECTORY -- and git
# never descends into an ignored directory, so the MANIFEST.json rule under
# it could never re-include anything. Zero manifests were tracked, which is
# the one artifact recording a release's LAYER hashes and per-class counts;
# doc2/kg_release_census.txt is committed but holds only the top-level
# nodes_sha and edges_sha. Verified with `git check-ignore -v` rather than
# by reading the pattern, because reading the pattern is what produced the
# broken one.
data/releases/*/*
!data/**/.gitkeep
!data/releases/**/MANIFEST.json
!data/releases/smoke/
*.parquet
*.pt
*.db
*.kuzu/
*.sqlite
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
.env
*.key
credentials.json

# web UI -- the chat frontend is ONE HTML FILE, web/chat.html, served by
# scripts/agent_server.py from the Python standard library. There is no
# node_modules, no lockfile, no build step and nothing here to ignore.
#
# What used to be ignored: web/node_modules/ (472MB), web/dist/,
# web/.vite/, web/patches/, web/.manus-logs/. Those belonged to a
# scaffolded React/Vite template that drew a hand-written graph and made
# no network call -- doc2/records/data_audit_2026-11-07.md listed it as "unused
# Manus template (fix list P11)". Deleted 2026-11-20.

# Review patches dropped in the worktree ROOT only. A bare *.patch glob
# was refused while web/patches/ held tracked pnpm dependency patches
# that were build inputs; that directory is gone, but the anchored form
# is still what is wanted -- a review patch lands in the root, and a
# bare glob would catch patch files anywhere in the tree.
/*.patch

# run_reproduce_block.py: lock and the script it runs
.reproduce.lock
.reproduce.sh
/kgav-*.patch

# Superseded release copies kept before a rebuild that overwrites v0.1 in
# place. Fix-list L26 is why they exist: the L27 rebuild destroyed the only
# artifact that could have said WHICH seven proteins left. Large and local.
data/archive/*
