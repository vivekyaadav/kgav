data/raw/*
data/interim/*
# ONE LEVEL DEEPER, SO THE NEGATION BELOW CAN APPLY (fix-list P12).
# This was `data/releases/*`, which ignores the release DIRECTORY -- and git
# never descends into an ignored directory, so the MANIFEST.json rule under
# it could never re-include anything. Zero manifests were tracked, which is
# the one artifact recording a release's LAYER hashes and per-class counts;
# docs/kg_release_census.txt is committed but holds only the top-level
# nodes_sha and edges_sha. Verified with `git check-ignore -v` rather than
# by reading the pattern, because reading the pattern is what produced the
# broken one.
data/releases/*/*
!data/**/.gitkeep
!data/releases/**/MANIFEST.json
!data/releases/smoke/
*.parquet
*.pt
*.db
*.kuzu/
*.sqlite
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
.env
*.key
credentials.json

# web UI
web/node_modules/
web/dist/
web/.vite/
web/client/public/data/

# agent-tooling artifacts, not part of the app
web/.manus-logs/
web/client/public/__manus__/
# Review patches dropped in the worktree ROOT only. Must NOT be a bare
# *.patch glob: web/patches/ holds pnpm dependency patches, which are
# build inputs. Those are tracked, so a bare glob does not remove them
# -- it silently drops the NEXT one `pnpm patch-commit` writes, and the
# build then differs between machines with nothing in git status to say so.
/*.patch

# run_reproduce_block.py: lock and the script it runs
.reproduce.lock
.reproduce.sh
/kgav-*.patch
