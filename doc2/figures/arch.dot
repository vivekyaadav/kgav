    S_vhppi [label="VirHostNet\nIntAct · MINT · DIP", fillcolor="#e8eef8", width=1.45, height=0.4];
    L_spine [label="spine\nviruses, viral proteins,\nthe taxonomy spine", fillcolor="#e9f5e1", width=1.55, height=0.55, style="rounded,filled"];
    L_host [label="host\nhuman proteins, genes,\npathways, host–host PPI", fillcolor="#e9f5e1", width=1.55, height=0.55, style="rounded,filled"];
    L_vhppi [label="vhppi\nvirus–host PPI", fillcolor="#e9f5e1", width=1.55, height=0.55, style="rounded,filled"];
    L_orcs [label="orcs\nhost dependency factors", fillcolor="#e9f5e1", width=1.55, height=0.55, style="rounded,filled"];
    L_curated [label="curated\nhost factors from\nhand-entered screens\n(declared, not in this release)", fillcolor="#f4f4f4", width=1.55, height=0.55, style="rounded,filled,dashed"];
    L_chembl [label="chembl\ncompound activity,\nviral-protein inhibition", fillcolor="#e9f5e1", width=1.55, height=0.55, style="rounded,filled"];
